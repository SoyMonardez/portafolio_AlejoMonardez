# =====================================================================
# Variables de entorno para Docker Compose
# Copiar este archivo a `.env` y completar los valores reales.
# NO subir el .env real a git (ya está en .gitignore).
# =====================================================================

# --- MySQL ---
# Contraseña del usuario root (interna al container)
MYSQL_ROOT_PASSWORD=cambiar_por_pass_root_fuerte
# Usuario y pass de la app (el backend conecta con esto, NO con root)
DB_USER=portfolio
DB_PASS=cambiar_por_pass_app_fuerte
DB_NAME=portfolio_moni

# --- Backend ---
# Generar uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar_por_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS=https://alejomonardez.com,https://www.alejomonardez.com

# Rate limit del formulario de contacto
CONTACT_RATE_MAX=3
CONTACT_RATE_WINDOW_MIN=60

# --- Notificaciones por email (Gmail SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=app_password_16_chars
NOTIFY_TO=donde_recibis_notificaciones@gmail.com

# --- AI Service (Groq) ---
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile
# Token opcional para proteger el ai-service de uso público (dejar vacío si no querés)
AI_SHARED_TOKEN=

# --- Frontend ---
# Puerto del host donde el frontend escucha. El nginx del VPS proxea a este.
# Si en el VPS no tenés otro nginx, podés poner 80 directo.
HOST_PORT=8080
