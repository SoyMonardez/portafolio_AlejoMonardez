# =====================================================================
# Backend del portfolio — configuración
# Copiá este archivo a `.env` y completá los valores reales.
# =====================================================================

# --- Servidor ---
PORT=3000
NODE_ENV=development

# Lista de orígenes permitidos por CORS, separados por coma.
# Ej: http://localhost:5173,https://alejomonardez.com
CORS_ORIGINS=http://localhost:5173,http://localhost,http://localhost:3000

# --- Base de datos MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=portfolio_moni

# --- JWT (auth admin) ---
# Generá uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# --- Uploads ---
UPLOAD_DIR=../uploads/projects
UPLOAD_MAX_MB=5
UPLOAD_PUBLIC_BASE=/uploads/projects

# --- Email (Gmail SMTP con App Password) ---
# 1. Activá 2FA en tu cuenta Google
# 2. Generá una App Password: https://myaccount.google.com/apppasswords
# 3. Pegala acá (16 caracteres sin espacios)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=app_password_de_16_chars
# A dónde te llegan las notificaciones de mensajes nuevos
NOTIFY_TO=tu_correo@gmail.com

# --- Rate limiting ---
# Máximo de mensajes por IP por hora en /contact
CONTACT_RATE_MAX=3
CONTACT_RATE_WINDOW_MIN=60
