# Copiar este archivo a `.env` y completar con tu API key real.
# 1. Cuenta gratis en https://console.groq.com
# 2. Generar key en https://console.groq.com/keys

GROQ_API_KEY=tu_api_key_aqui

# Opcional — modelo a usar (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Opcional — puerto del servicio (default: 3001)
PORT=3001

# Opcional — token compartido con el frontend para autorizar pedidos.
# Si lo dejás vacío, cualquiera con acceso a la URL puede llamarlo.
# Recomendado en producción.
AI_SHARED_TOKEN=
